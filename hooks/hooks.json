{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/session-cards/hook-cli.ts\" start"
          },
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/session-init.ts\""
          },
          {
            "type": "command",
            "command": "D=\"${DIGISMITH_DEPOT_DIR:-$HOME/.digismith-depot}\"; [ -n \"$DIGISMITH_RUN_ID\" ] || [ -d \"$D\" ] || exit 0; NODE_COMPILE_CACHE=\"$D/runs/.index/node-cache\" node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/run-events/hook-cli.ts\" started"
          },
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/workbox-health/drift-check.ts\" --alarm --repo \"$PWD\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/session-cards/hook-cli.ts\" prompt"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${DIGISMITH_DEPOT_DIR:-$HOME/.digismith-depot}\"; [ -n \"$DIGISMITH_RUN_ID\" ] || [ -d \"$D\" ] || exit 0; NODE_COMPILE_CACHE=\"$D/runs/.index/node-cache\" node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/run-events/hook-cli.ts\" blocked"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${DIGISMITH_DEPOT_DIR:-$HOME/.digismith-depot}\"; [ -n \"$DIGISMITH_RUN_ID\" ] || [ -d \"$D\" ] || exit 0; NODE_COMPILE_CACHE=\"$D/runs/.index/node-cache\" node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/run-events/hook-cli.ts\" tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${DIGISMITH_DEPOT_DIR:-$HOME/.digismith-depot}\"; [ -n \"$DIGISMITH_RUN_ID\" ] || [ -d \"$D\" ] || exit 0; NODE_COMPILE_CACHE=\"$D/runs/.index/node-cache\" node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/run-events/hook-cli.ts\" turn_end"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/session-cards/hook-cli.ts\" end"
          },
          {
            "type": "command",
            "command": "D=\"${DIGISMITH_DEPOT_DIR:-$HOME/.digismith-depot}\"; [ -n \"$DIGISMITH_RUN_ID\" ] || [ -d \"$D\" ] || exit 0; NODE_COMPILE_CACHE=\"$D/runs/.index/node-cache\" node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/run-events/hook-cli.ts\" ended"
          }
        ]
      }
    ]
  }
}
