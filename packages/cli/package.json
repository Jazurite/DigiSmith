{
  "name": "@digismith/cli",
  "version": "0.1.0-beta",
  "description": "DigiSmith's command line — binaries, dispatcher, and command-group framework",
  "license": "MIT",
  "dependencies": {
    "yargs": "^17.7.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "digismith": "dist/index.js",
    "dg": "dist/index.js"
  },
  "files": [
    "dist"
