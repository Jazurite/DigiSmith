{
  "name": "@digismith/cli",
  "version": "0.1.0",
  "description": "DigiSmith's command line — Depot's distribution surface",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "digismith": "dist/index.js",
    "dg": "dist/index.js"
  },
  "files": [
    "dist"
  ],
