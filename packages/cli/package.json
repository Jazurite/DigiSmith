  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jazurite/DigiSmith.git",
    "directory": "packages/cli"
  },
  "author": {
    "name": "Jack Huỳnh",
    "email": "jack@jazurite.com"
  }
}
