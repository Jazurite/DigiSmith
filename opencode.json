{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "maestro",
  "provider": {
    "tokenreply": {
      "models": {
        "gpt-5.6-luna": {
          "name": "TokenReply GPT-5.6 Luna",
          "limit": {
            "context": 200000,
            "output": 65535
          }
        },
        "claude-sonnet-5-5": {
          "name": "TokenReply Claude Sonnet 5.5",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    }
  },
  "agent": {
    "maestro": {
      "description": "DigiSmith maestro (luna): routine turns. Guarded: herdr only through herdr-ws, no destructive shell.",
      "mode": "primary",
      "model": "tokenreply/gpt-5.6-luna",
      "prompt": "{file:./.opencode/prompts/maestro.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "*/.digismith/sessions/opencode-maestro/*": "allow",
          "*/.digismith/board/*/worker-opencode-maestro/*": "allow"
        },
        "bash": {
          "*": "deny",
          "HERDR_WS=w2 /Users/workbox/.digismith-depot/bin/herdr-ws *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "date": "allow",
          "date *": "allow",
          "*.env*": "deny",
          "*password*": "deny",
          "*passwd*": "deny",
          "*auth.json*": "deny",
          "*.ssh*": "deny",
          "*token*": "deny",
          "*secret*": "deny",
          "*credential*": "deny",
          "*opencode.json*": "deny",
          "*/.config/opencode*": "deny",
          "*tokenreply*": "deny",
          "*.pem*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*.key*": "deny",
          "*|*": "deny",
          "*>*": "deny",
          "*<*": "deny",
          "*;*": "deny",
          "*&*": "deny",
          "*$*": "deny",
          "*`*": "deny",
          "*\n*": "deny",
          "*--output*": "deny",
          "*--no-index*": "deny",
          "*herdr *": "deny",
          "*/.local/bin*": "deny"
        },
        "read": {
          "*": "allow",
          "*.env*": "deny",
          "*password*": "deny",
          "*passwd*": "deny",
          "*auth.json*": "deny",
          "*.ssh*": "deny",
          "*token*": "deny",
          "*secret*": "deny",
          "*credential*": "deny",
          "*opencode.json*": "deny",
          "*/.config/opencode*": "deny",
          "*tokenreply*": "deny",
          "*.pem*": "deny",
          "*id_rsa*": "deny",
          "*id_ed25519*": "deny",
          "*.key*": "deny",
          "*.env.example": "allow"
        },
        "grep": "deny",
        "glob": "deny",
        "list": {
          "*": "allow",
          "*.env*": "deny",
          "*password*": "deny",
