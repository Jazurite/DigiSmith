# DigiSmith secrets — copy this file to `.env` and fill in real values.
# `.env` is gitignored; this example file is the only one ever committed.
# Nothing in here should ever be pasted into a chat session or a
# git-committed profile file (see backlog/jira-rest-graphql-direct-api.md).

# Jira/Atlassian personal API token, generated at:
# https://id.atlassian.com/manage-profile/security/api-tokens
# Used with HTTP Basic Auth (JIRA_EMAIL:JIRA_API_TOKEN) directly against
# https://<JIRA_SITE>/rest/api/3/... — not the api.atlassian.com/ex/jira/
# gateway, which is OAuth-app-only.
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SITE=emma-sleep.atlassian.net
