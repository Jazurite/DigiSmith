# DigiSmith secrets — copy this file to `~/.digismith/.env` (your home
# directory, outside every git repo) and fill in real values. That home
# path is the only location the Jira client reads; a copy left in a repo
# root is never loaded. Nothing in here should ever be pasted into a chat
# session or a git-committed profile file — see
# `.digismith/docs/jira-rest-migration/design.html` for the full
# token-storage design.

# Jira/Atlassian personal API token, generated at:
# https://id.atlassian.com/manage-profile/security/api-tokens
# Used with HTTP Basic Auth (JIRA_EMAIL:JIRA_API_TOKEN) directly against
# https://<JIRA_SITE>/rest/api/3/... — not the api.atlassian.com/ex/jira/
# gateway, which is OAuth-app-only.
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SITE=emma-sleep.atlassian.net

# Chutes.ai API key, used by scripts/model_offload.ts and
# skills/offload-implementer to offload HTML generation / whole tasks to
# a Chutes-hosted model when the active profile's provider is `chutes`.
CHUTES_API_KEY=

# TokenReply API key, same offload paths as above when the active
# profile's provider is `tokenreply` instead.
TOKENREPLY_API_KEY=
