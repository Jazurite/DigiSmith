{
	admin off
	https_port 8443
	auto_https disable_redirects
	default_bind 127.0.0.1
}

(opencode_routes) {
	reverse_proxy 127.0.0.1:4198
}

opencode.pazurite.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	import opencode_routes
}

pazurite.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	# Nexus API (DGS-324): the whole /api/* space goes to the API, which names the version. No login for now (tailnet only, read-only; login design: DGS-458).
	handle /api/* {
		reverse_proxy 127.0.0.1:4300 {
			header_up -Authorization
		}
	}
	handle {
		respond "Not found" 404
	}
}
