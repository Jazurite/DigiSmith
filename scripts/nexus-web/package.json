{
  "name": "@digismith/nexus-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate && NEXUS_SITE=oculus nuxt generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:built": "pnpm generate && pnpm build-storybook && vitest run tests/unit/built-page.test.ts tests/unit/built-oculus.test.ts tests/unit/built-storybook.test.ts",
    "postinstall": "nuxt prepare",
    "e2e": "pnpm generate && playwright test tests/e2e",
    "e2e:install": "playwright install chromium",
    "a11y": "pnpm generate && playwright test tests/a11y",
    "visual": "playwright test tests/visual",
    "visual:update": "playwright test tests/visual --update-snapshots",
    "perf": "pnpm generate && playwright test tests/perf",
    "lhci": "pnpm generate && CHROME_PATH=$(node tests/perf/chrome-path.mjs) lhci autorun --config=lighthouserc.mobile.cjs && CHROME_PATH=$(node tests/perf/chrome-path.mjs) lhci autorun --config=lighthouserc.desktop.cjs"
  },
  "dependencies": {
    "hono": "4.13.13",
    "nuxt": "4.6.1",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@hono/node-server": "2.1.5",
    "@lhci/cli": "0.15.1",
    "@nuxt/test-utils": "4.3.3",
    "@nuxtjs/storybook": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.3",
    "sass": "1.105.2",
    "storybook": "10.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "web-vitals": "6.2.3"
  }
}
