{
  "name": "@digismith/nexus-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:built": "nuxt generate && vitest run tests/unit/built-page.test.ts",
    "postinstall": "nuxt prepare",
    "e2e": "nuxt generate && playwright test tests/e2e",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "hono": "4.13.13",
    "nuxt": "4.6.1",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.5",
    "@nuxt/test-utils": "4.3.3",
    "@nuxtjs/storybook": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.3",
    "sass": "1.105.2",
    "storybook": "10.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
