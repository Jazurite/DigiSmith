#!/usr/bin/env python3
"""herdr-ws: herdr limited to a scope of (session, workspace) pairs (DGS-198 guardrail, DGS-683 scope).
Scope: HERDR_SCOPE = comma list "session:workspace" (for example Suite:w7,default:w2,default:w3). Absent: default:$HERDR_WS (HERDR_WS must match ^w\\d+$ like every scope workspace).
--session S as the first argument selects the session (S must be in the scope; no --session = default). Allowed groups: agent, pane, tab.
Every target must sit in a workspace the scope names for that session. Lists are filtered. create needs --workspace in that set.
start and prompt-type verbs check the target. The wrapper builds the herdr argv itself: it never forwards a --session or --socket of the caller."""
import datetime, json, os, re, subprocess, sys
HERDR = "/Users/workbox/.local/bin/herdr"
H = [HERDR, "--session", "default"]  # H[0] is the herdr path; the session is set per call by run()
SESSION_RE = re.compile(r"^[A-Za-z][\w-]*$")
WS_RE = re.compile(r"^w\d+$")
def deny(m): sys.stderr.write("herdr-ws: refused: %s\n" % m); sys.exit(3)
def parse_scope():
    raw = os.environ.get("HERDR_SCOPE", "")
    if not raw:
        ws = os.environ.get("HERDR_WS", "")
        if not ws: deny("HERDR_SCOPE or HERDR_WS not set")
        raw = "default:" + ws
    pairs = []
    for item in raw.split(","):
        parts = item.split(":")
        if len(parts) != 2 or not SESSION_RE.match(parts[0]) or not WS_RE.match(parts[1]):
            deny("bad scope entry %r (want session:wN)" % item)
        pairs.append((parts[0], parts[1]))
    return pairs
SCOPE = parse_scope()
a = sys.argv[1:]
SESSION = "default"
if a and a[0] == "--session":
    if len(a) < 2: deny("--session needs a name")
    SESSION, a = a[1], a[2:]
if not SESSION_RE.match(SESSION) or SESSION not in {s for s, _ in SCOPE}: deny("session %s is not in the scope" % SESSION)
if any(x.split("=")[0] in ("--session", "--socket") for x in a): deny("--session and --socket are not accepted here")
WSS = {w for s, w in SCOPE if s == SESSION}
# DGS-408: the OpenCode server runs with XDG_CONFIG_HOME in its own home; herdr finds its socket under XDG_CONFIG_HOME, so the herdr subprocess (and only it) gets the real one.
# Proven: of XDG_CONFIG/DATA/STATE/CACHE_HOME only XDG_CONFIG_HOME changes where herdr looks.
HERDR_ENV = {k: v for k, v in os.environ.items() if k != "HERDR_SOCKET_PATH"}
HERDR_ENV["XDG_CONFIG_HOME"] = "/Users/workbox/.config"
def run(args): return subprocess.run([H[0], "--session", SESSION] + args, capture_output=True, text=True, env=HERDR_ENV)
def find(o, key):
    if isinstance(o, dict):
        if key in o: return o[key]
        for v in o.values():
            r = find(v, key)
            if r: return r
    elif isinstance(o, list):
        for v in o:
            r = find(v, key)
            if r: return r
    return ""
def ws_of(t):
    if t.startswith("w") and ":" in t: return t.split(":")[0]
    r = run(["agent", "get", t])
    try: return find(json.loads(r.stdout), "workspace_id")
    except Exception: return ""
def ticket_name(n): return n.startswith("tc-") or n.startswith("nw-")
def agent_of_pane(p):
    try:
        for x in json.loads(run(["agent", "list"]).stdout).get("result", {}).get("agents", []):
            if x.get("pane_id") == p: return x.get("name", "")
    except Exception: pass
    return ""
def current_label(g, t):
    # the name the Suite rules judge: a tab's label (tab get), an agent's name, or the agent that owns a pane; "" when unknown (fail closed)
    if g == "tab":
        try: return find(json.loads(run(["tab", "get", t]).stdout), "label") or ""
        except Exception: return ""
    if g == "agent": return agent_of_pane(t) if re.match(r"^w\d+:p", t) else t
    return agent_of_pane(t)
def flag_values(args, names):
    return [args[i + 1] for i, x in enumerate(args) if x in names and i + 1 < len(args)]
def relocate_check(args):
    # pane move / pane swap relocate a pane between tabs or workspaces: every pane and destination named must be in the scope; in Suite every pane named must also belong to a tc-/nw- agent
    # (else a conductor's pane could be moved into a tc- tab, and closing that tab would pass the label check). Implicit panes (--current, a swap neighbour by --direction) are refused: they cannot be checked.
    if "--new-workspace" in args or "--current" in args: deny("%s is not accepted for pane move or swap here" % ("--new-workspace" if "--new-workspace" in args else "--current"))
    panes = flag_values(args, ("--pane", "--source-pane", "--target-pane"))
    if args and not args[0].startswith("-"): panes.append(args[0])
    if verb == "swap" and (len(set(panes)) < 2 or not (set(flag_values(args, ("--source-pane",))) or set(flag_values(args, ("--pane",))))): deny("pane swap needs two named panes")
    if verb == "swap" and "--direction" in args and not flag_values(args, ("--target-pane",)): deny("pane swap neighbour must be named with --target-pane")
    if not panes: deny("pane move needs a named pane")
    dests = flag_values(args, ("--tab",)) + flag_values(args, ("--workspace",))
    for x in panes + dests:
        w = x if WS_RE.match(x) else ws_of(x)
        if w not in WSS: deny("%s is not in the scope of session %s" % (x, SESSION))
    if SESSION == "Suite":
        for x in panes:
            if not ticket_name(agent_of_pane(x)): deny("in Suite only panes of tc- or nw- conductors can be moved or swapped")
    return panes[0]
def audit(tgt, tws):
    # DGS-683 spec 6.3/7.1 item 5: a non-read act in the Floor on a workspace other than the caller's own appends one JSON line to <depot>/drivers/<KEY>.log.
    # Logged when the call is forwarded (an attempt), never blocks the call: a write failure prints one line on stderr.
    own = os.environ.get("HERDR_WS", "")
    if SESSION != "default" or not own or verb in ("list", "get", "read") or tws == own: return
    try:
        name = agent_of_pane(tgt) if re.match(r"^w\d+:p", tgt) else tgt
        m = re.search(r"dgs-\d+", name, re.I)
        depot = os.environ.get("DIGISMITH_DEPOT_DIR") or os.path.join(os.path.expanduser("~"), ".digismith-depot")
        os.makedirs(os.path.join(depot, "drivers"), exist_ok=True)
        t = datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=7))).isoformat(timespec="seconds")
        rec = {"time": t, "who": os.environ.get("DIGISMITH_NAME") or "unknown", "target": tgt, "workspace": tws, "verb": "%s %s" % (grp, verb)}
        with open(os.path.join(depot, "drivers", (m.group(0).upper() if m else "_unmapped") + ".log"), "a") as f: f.write(json.dumps(rec) + "\n")
    except Exception as e: sys.stderr.write("herdr-ws: audit log not written: %s\n" % e)
if len(a) < 2: deny("usage: herdr-ws [--session S] <agent|pane|tab> <verb> [target] ...")
grp, verb, rest = a[0], a[1], a[2:]
if grp not in ("agent", "pane", "tab"): deny("group %s not allowed" % grp)
if verb == "list":
    if grp in ("pane", "tab"):
        if len(WSS) == 1:
            r = run([grp, "list", "--workspace", next(iter(WSS))])
        else:
            merged, r, env0 = {}, None, None
            for w in sorted(WSS):
                r = run([grp, "list", "--workspace", w])
                if r.returncode != 0: break
                try:
                    d = json.loads(r.stdout)
                    if env0 is None: env0 = d
                    for k, v in d.get("result", {}).items():
                        if isinstance(v, list): merged.setdefault(k, []).extend(v)
                except Exception: deny("could not merge %s list" % grp)
            if r.returncode == 0:
                env0.setdefault("result", {}).update(merged)  # keep the first reply's envelope, merge only the lists
                sys.stdout.write(json.dumps(env0) + "\n"); sys.exit(0)
    else:
        r = run(["agent", "list"])
        try:
            d = json.loads(r.stdout)
            def keep(x): return find(x, "workspace_id") in WSS
            for k, v in d.get("result", {}).items():
                if isinstance(v, list): d["result"][k] = [x for x in v if keep(x)]
            print(json.dumps(d)); sys.exit(0)
        except Exception: deny("could not filter agent list")
    sys.stdout.write(r.stdout); sys.stderr.write(r.stderr); sys.exit(r.returncode)
if a.count("--workspace") > 1 or a.count("--pane") > 1: deny("--workspace and --pane may appear only once")
TGT, TWS = "", ""  # what the call acts on, and that target's workspace (for the audit log)
if verb == "create":
    if "--workspace" not in rest or rest.index("--workspace") + 1 >= len(rest) or rest[rest.index("--workspace") + 1] not in WSS:
        deny("create needs --workspace in %s" % ",".join(sorted(WSS)))
    TWS = rest[rest.index("--workspace") + 1]; TGT = TWS
    cmd = a
else:
    if not rest: deny("target missing")
    tgt = rest[0]; TGT = tgt
    if verb == "start":  # agent start <name> --pane <id>
        if "--pane" not in rest or rest.index("--pane") + 1 >= len(rest): deny("--pane outside the scope")
        TWS = ws_of(rest[rest.index("--pane") + 1])
        if TWS not in WSS: deny("--pane outside the scope")
    elif grp == "pane" and verb in ("move", "swap"): TGT = relocate_check(rest); TWS = ws_of(TGT)
    else:
        TWS = ws_of(tgt)
        if TWS not in WSS: deny("target %s is not in the scope of session %s" % (tgt, SESSION))
    cmd = a
if SESSION == "Suite":
    # DGS-683: in Suite the close rule is a label rule, not a position rule: only ticket conductors (tc-) and on-call (nw-) can be closed.
    # A label can be changed by rename, so rename is judged too: the CURRENT name and the NEW name must both be tc-/nw-.
    # herdr has no "agent stop" verb today; it stays here because the spec names it (7.1 item 4).
    if (grp == "tab" and verb == "close") or (grp == "agent" and verb == "stop") or (grp == "pane" and verb == "close"):
        if not ticket_name(current_label(grp, rest[0])): deny("in Suite only tc- or nw- conductors can be closed")
    elif verb == "rename":
        if rest[0].startswith("-") or len(rest) < 2 or rest[1].startswith("-"): deny("in Suite rename needs a target and a new name")
        if not ticket_name(current_label(grp, rest[0])): deny("in Suite only tc- or nw- conductors can be renamed")
        if not ticket_name(rest[1]): deny("in Suite a new name must keep the tc- or nw- prefix")
elif verb in ("close",) and grp == "tab" and rest and rest[0] in {w + ":t1" for w in WSS}: deny("tab 1 (maestro) cannot be closed here")
audit(TGT, TWS)
r = run(cmd)
sys.stdout.write(r.stdout); sys.stderr.write(r.stderr); sys.exit(r.returncode)
